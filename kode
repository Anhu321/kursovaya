def get_events_from_site():
    """Парсинг сайта с картинками"""
    events = []
    try:
        headers = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}
        response = requests.get("https://dosug-abakan.ru/", timeout=10, headers=headers)
        soup = BeautifulSoup(response.text, 'html.parser')
        
        # Ищем ссылки с мероприятиями
        links = soup.find_all('a', href=True)
        for link in links:
            title = link.get_text(strip=True)
            if 10 < len(title) < 100:
                parent = link.find_parent()
                
                # Ищем картинку
                image_url = None
                if parent:
                    img = parent.find('img')
                    if img and img.get('src'):
                        image_url = urljoin('https://dosug-abakan.ru/', img['src'])
                
                # Ищем дату
                datetime_text = "Дата уточняется"
                if parent:
                    date_match = re.search(r'\d{1,2}\s+(янв|фев|мар|апр|мая|июн|июл|авг|сен|окт|ноя|дек)', parent.get_text())
                    if date_match:
                        datetime_text = date_match.group()
                
                # Ищем цену
                price = "Уточняйте"
                if parent and 'руб' in parent.get_text():
                    price_match = re.search(r'(\d+[\s\d]*\s*руб)', parent.get_text())
                    if price_match:
                        price = price_match.group()
                
                events.append({
                    'title': title[:100],
                    'datetime': datetime_text,
                    'place': 'Абакан',
                    'description': parent.get_text(strip=True)[:200] if parent else title,
                    'price': price,
                    'link': urljoin('https://dosug-abakan.ru/', link['href']),
                    'image_url': image_url
                })
                
                if len(events) >= 5:
                    break
        
        if not events:
            # Демо-мероприятия
            events = [
                {
                    'title': '🎨 День города Абакан',
                    'datetime': '15-16 июня 2026, 10:00-22:00',
                    'place': 'Центральная площадь',
                    'description': 'Праздничный концерт, салют, ярмарка, мастер-классы.',
                    'price': 'Бесплатно',
                    'link': '',
                    'image_url': None
                },
                {
                    'title': '🎭 Спектакль "Вишневый сад"',
                    'datetime': '18 июня 2026, 18:30',
                    'place': 'Русский драматический театр',
                    'description': 'Классическая постановка Чехова.',
                    'price': '400-700 руб',
                    'link': '',
                    'image_url': None
                }
            ]
    except Exception as e:
        print(f"Ошибка: {e}")
        events = []
    
    return events

def send_event_as_message(user_id, event, index=None, total=None):
    """Отправляет событие отдельным сообщением"""
    if index and total:
        header = f"🎯 *Мероприятие {index}/{total}*\n\n"
    else:
        header = "🎉 *МЕРОПРИЯТИЕ*\n\n"
    
    message = header
    message += f"*{event['title']}*\n\n"
    message += f"📅 *Когда:* {event['datetime']}\n"
    message += f"📍 *Где:* {event['place']}\n"
    message += f"💰 *Цена:* {event['price']}\n\n"
    message += f"📖 *Описание:*\n{event['description'][:300]}\n"
    
    if event.get('link'):
        message += f"\n🔗 Подробнее: {event['link']}"
    
    try:
        vk.messages.send(user_id=user_id, message=message, random_id=0)
        return True
    except Exception as e:
        print(f"Ошибка: {e}")
        return False

def post_to_wall(event):
    """Публикация на стену"""
    try:
        message = f"🎉 *{event['title']}*\n\n"
        message += f"📅 *Когда:* {event['datetime']}\n"
        message += f"📍 *Где:* {event['place']}\n"
        message += f"💰 *Цена:* {event['price']}\n\n"
        message += f"📖 *Описание:*\n{event['description']}\n"
        
        vk.wall.post(owner_id=f"-{GROUP_ID}", message=message, from_group=1)
        return True
    except Exception as e:
        print(f"Ошибка: {e}")
        return False

def save_proposal(user_id, event_data):
    """Сохранение предложения"""
    proposals = []
    if os.path.exists(PROPOSALS_FILE):
        with open(PROPOSALS_FILE, 'r', encoding='utf-8') as f:
            proposals = json.load(f)
    
    proposal_id = len(proposals) + 1
    proposals.append({
        'id': proposal_id,
        'user_id': user_id,
        'data': event_data,
        'status': 'pending',
        'created_at': datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    })
    
    with open(PROPOSALS_FILE, 'w', encoding='utf-8') as f:
        json.dump(proposals, f, ensure_ascii=False, indent=2)
    
    return proposal_id

