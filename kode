def send_message(user_id, message, keyboard=None):
    """Отправка сообщения"""
    try:
        data = {'user_id': user_id, 'message': message, 'random_id': 0}
        if keyboard:
            data['keyboard'] = keyboard.get_keyboard()
        vk.messages.send(**data)
        return True
    except Exception as e:
        print(f"❌ Ошибка: {e}")
        return False

